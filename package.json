{
  "name": "enrolla-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Enrolla student portal demo and Supabase deployment configuration",
  "scripts": {
    "dev": "serve .",
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('index.html')) process.exit(1); fs.mkdirSync('dist',{recursive:true}); fs.copyFileSync('index.html','dist/index.html')\"",
    "preview": "serve .",
    "test": "npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:link": "supabase link --project-ref ${SUPABASE_PROJECT_ID}",
    "db:push": "supabase db push",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "serve": "^14.2.4",
    "supabase": "^2.31.8"
  }
}
